# WinterShield AI - Environment Variables

# Lovable AI Gateway key (Server-side only)
# Required for the AI Smog Assistant to stream answers via @lovable.dev/ai-gateway
LOVABLE_API_KEY=your_lovable_api_key_here

# Deployment target preset (Optional, automatically detected on Vercel)
# Examples: 'vercel', 'node-server', 'cloudflare'
# NITRO_PRESET=vercel

# Port for local production preview server (Optional, default: 3000)
# PORT=3000
